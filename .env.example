# ScreenView environment variables — names and purposes only (no secrets).
# Copy to `.env.local` and fill with real values. `.env.local` is gitignored.

# --- Supabase (create a project, then Settings → API) ---------------------
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Public anon key (safe in browser; protected by RLS).
SUPABASE_SERVICE_ROLE_KEY=           # Server-only. Used by jobs/privileged ops. NEVER expose to the browser.

# --- AI providers ----------------------------------------------------------
GROQ_API_KEY=                        # Server-only. Vision + reasoning calls (Groq).
NVIDIA_API_KEY=                      # Server-only. Embeddings (NVIDIA NIM API).
OPENROUTER_API_KEY=                  # Server-only. Optional vision fallback (off by default).

# --- Jobs (Inngest) --------------------------------------------------------
INNGEST_EVENT_KEY=                   # Server-only. Enqueue processing events.
INNGEST_SIGNING_KEY=                 # Server-only. Verify the job endpoint.

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000        # Canonical URL for links and redirects.

# --- Model configuration (Phase 3: model IDs are configuration) ------------
VISION_MODEL_ID=qwen/qwen3.8-27b                   # Groq vision model.
REASONING_MODEL_ID=openai/gpt-oss-120b             # Groq reasoning model.
# ⚠️ DEVELOPMENT/TESTING ONLY: free endpoint logs inputs — don't use for real private
# data long-term. Host-swappable later (same model, no schema change).
EMBEDDING_MODEL_ID=nvidia/llama-nemotron-embed-vl-1b-v2:free

# --- Ops -------------------------------------------------------------------
PROCESSING_PAUSED=                   # Set to 1 to pause AI processing (kill switch).
